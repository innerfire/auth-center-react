{
  "name": "@innerfire/auth-center-react",
  "version": "0.1.3",
  "description": "React account center SDK for Casdoor PKCE, Gateway auth, profile management, and account UI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innerfire/auth-center-react.git"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "react",
    "authentication",
    "casdoor",
    "account-center"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./gateway-profile": {
      "types": "./dist/gateway-profile.d.ts",
      "import": "./dist/gateway-profile.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./spa": {
      "types": "./dist/spa.d.ts",
      "import": "./dist/spa.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:package": "publint . && npm_config_cache=/tmp/innerfire-auth-center-npm-cache attw --pack . --profile esm-only",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^6.3.5",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@arethetypeswrong/cli": "^0.18.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^6.1.0",
    "tsdown": "^0.15.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
